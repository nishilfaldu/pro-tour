{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "app_tour", "feature_tour"],
  "properties": {
    "version": {"const": 1},
    "app_tour": {"$ref": "#/$defs/tour"},
    "feature_tour": {"$ref": "#/$defs/tour"}
  },
  "$defs": {
    "tour": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"$ref": "#/$defs/goal"}
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "goal", "checks", "text_values"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
        "checks": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "text_values": {
          "type": "object", "maxProperties": 8,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  }
}
