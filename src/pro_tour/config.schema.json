{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pro Tour repository configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "app", "app_paths", "journeys", "reset", "budgets"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "install", "start", "url", "port", "readiness_timeout_seconds", "public_env", "allowed_origins"],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 256},
        "install": {"$ref": "#/$defs/command"},
        "build": {"$ref": "#/$defs/command"},
        "start": {"$ref": "#/$defs/command"},
        "url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "readiness_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "public_env": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"pattern": "^(PUBLIC|VITE|NEXT_PUBLIC)_[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])"},
          "additionalProperties": {"type": "string", "maxLength": 2048, "pattern": "^[^\u0000-\u001f\u007f]*(?![\\s\\S])"}
        },
        "allowed_origins": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"type": "string", "maxLength": 256}
        }
      }
    },
    "app_paths": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "journeys": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "goal", "checkpoints"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
          "goal": {"$ref": "#/$defs/description"},
          "checkpoints": {
            "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
            "items": {"$ref": "#/$defs/description"}
          }
        }
      }
    },
    "reset": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "instructions"],
      "properties": {
        "strategy": {"const": "fresh-browser"},
        "instructions": {"$ref": "#/$defs/description"}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["install_seconds", "run_seconds", "tour_seconds", "actions_per_tour", "provider_calls", "provider_timeout_seconds", "tour_attempts"],
      "properties": {
        "install_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "run_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "tour_seconds": {"type": "integer", "minimum": 10, "maximum": 600},
        "actions_per_tour": {"type": "integer", "minimum": 1, "maximum": 100},
        "provider_calls": {"type": "integer", "minimum": 4, "maximum": 500},
        "provider_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "tour_attempts": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\u0000-\u001f\u007f]+(?![\\s\\S])"}
    },
    "description": {
      "type": "string", "minLength": 1, "maxLength": 2000,
      "pattern": "^[^\u0000-\u001f\u007f]*[^\\s\u0000-\u001f\u007f][^\u0000-\u001f\u007f]*(?![\\s\\S])"
    }
  }
}
