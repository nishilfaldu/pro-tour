  "bin": {
    "pro-tour": "bin/pro-tour.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src"
  ],
  "dependencies": {
    "playwright": "^1.64.0"
  }
}
