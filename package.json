{
  "name": "pro-tour",
  "version": "0.1.0",
  "description": "Record captioned feature tours of a pull request with Playwright, for coding agents and their reviewers",
  "license": "MIT",
  "keywords": [
    "pull-request",
    "code-review",
    "playwright",
    "video",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor"
  ],
  "homepage": "https://pro-tour.nishilfaldu.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishilfaldu/pro-tour.git"
  },
  "bugs": "https://github.com/nishilfaldu/pro-tour/issues",
  "scripts": {
    "test": "pnpm lint && pnpm typecheck && node --test 'tests/*.test.ts'",
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "bin": {
    "pro-tour": "bin/pro-tour.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "skill"
  ],
  "dependencies": {
    "playwright": "^1.64.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts"
}
