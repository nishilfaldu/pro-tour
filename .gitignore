# Patterns without a leading slash also cover nested directories.

# macOS metadata
.DS_Store
._*
.AppleDouble/
.LSOverride

# Python caches, environments, and build output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/

# UV's local resolution state; installation uses pyproject.toml directly.
/uv.lock

# Node dependencies and browser-test output
node_modules/
playwright-report/
test-results/

# Local credentials (keep safe example/template files trackable)
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Local validation output, recordings, and adjacent plans/traces/reports
.artifacts/
.videos/
