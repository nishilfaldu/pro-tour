# Patterns without a leading slash also cover nested directories.

# macOS metadata
.DS_Store
._*
.AppleDouble/
.LSOverride

# Node dependencies and browser-test output
node_modules/
playwright-report/
test-results/

# Local credentials (keep safe example/template files trackable)
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Local validation output, recordings, and adjacent plans/traces/reports
.artifacts/
.videos/

# Vercel project link
.vercel/
